import tecnologias.*
import orbalion.*
import entrenadores.*

describe "Checkpoint 1 - Energia total de equipos" {
    test "Un entrenador no puede tener un rol distinto a los autorizados por la FOZ" {
        const entrenador = new Entrenadores(
            cantDeCiclosSolaresDeExp = 12,
            estaEnSintonia = true,
            nivelDePrecisionEstrategica = 90,
            rol = "Estratega Cuántico"
        )

        assert.throwsExceptionWithMessage(
            "Rol no homologado por la FOZ", {entrenador.cambiarRol("Piloto Estelar")}
        )
    }

    test "Un equipo luminico con radiacion > 5000 y sin tecnologias activas -> su energia total es su energia base" {
        const tomas = new Entrenadores(
            cantDeCiclosSolaresDeExp = 32,
            estaEnSintonia = true,
            nivelDePrecisionEstrategica = 90,
            rol = "Estratega Cuántico"
        )
        
        const nucleosGravitacionales = new Tecnologias(
            nombre = "nucleos gravitacionales",
            valorEnergetico = 200,
            activa = false
        )

        const equipo = new Luminicos(
            nombre = "Aurora",
            energiaBase = 100,
            entrenador = tomas,
            tecnologias = [nucleosGravitacionales],
            nivelDeRadiacion = 6000
        )

        assert.equals(100, equipo.energiaTotal())
    }

    test "Un equipo lumínico con radiación < 5000 → obtiene el bono del 10%." {
        const mateo = new Entrenadores(
            cantDeCiclosSolaresDeExp = 32,
            estaEnSintonia = true,
            nivelDePrecisionEstrategica = 90,
            rol = "Estratega Cuántico"
        )
        
        const interfacesDeProyeccionMental = new Tecnologias(
            nombre = "interfaces de proyeccion mental",
            valorEnergetico = 500,
            activa = true
        )

        const equipo = new Luminicos(
            nombre = "Aurora",
            energiaBase = 100,
            entrenador = mateo,
            tecnologias = [interfacesDeProyeccionMental],
            nivelDeRadiacion = 400
        )

        assert.equals(660, equipo.energiaTotal())
    }

    test "Un equipo sintético con 6 módulos → aplica correctamente la penalización del 20%." {
        const tomas = new Entrenadores(
            cantDeCiclosSolaresDeExp = 32,
            estaEnSintonia = true,
            nivelDePrecisionEstrategica = 90,
            rol = "Estratega Cuántico"
        )
        
        const interfacesDeProyeccionMental = new Tecnologias(
            nombre = "interfaces de proyeccion mental",
            valorEnergetico = 500,
            activa = true
        )

        const equipo = new Sinteticos(
            nombre = "Aurora",
            energiaBase = 100,
            entrenador = tomas,
            tecnologias = [interfacesDeProyeccionMental],
            nivelDeProcesamientoCentral = 0,
            cantDeModulosActivos = 6,
            estaCertificado = true
        )

        assert.equals(480, equipo.energiaTotal())
    }

    test "Un equipo sintético con 4 módulos y 2 tecnologías complementarias → suma correctamente los valores energéticos." {
        const mateo = new Entrenadores(
            cantDeCiclosSolaresDeExp = 32,
            estaEnSintonia = true,
            nivelDePrecisionEstrategica = 90,
            rol = "Estratega Cuántico"
        )
        
        const nucleosGravitacionales = new Tecnologias(
            nombre = "nucleos gravitacionales",
            valorEnergetico = 200,
            activa = true
        )

        const interfacesDeProyeccionMental = new Tecnologias(
            nombre = "interfaces de proyeccion mental",
            valorEnergetico = 500,
            activa = true
        )

        const equipo = new Sinteticos(
            nombre = "Aurora",
            energiaBase = 100,
            entrenador = mateo,
            tecnologias = [nucleosGravitacionales, interfacesDeProyeccionMental],
            nivelDeProcesamientoCentral = 40,
            cantDeModulosActivos = 4,
            estaCertificado = true
        )

        assert.equals(800, equipo.energiaTotal())
    }
}

describe "Checkpoint 2 - Entrenadores de élite galáctica." {
    test "Estratega cuántico con 12 ciclos y precisión 90 → es de élite galáctica." {
        const entrenador = new Entrenadores(
            cantDeCiclosSolaresDeExp = 12,
            estaEnSintonia = false,
            nivelDePrecisionEstrategica = 90,
            rol = "Estratega Cuántico"
        )

        assert.that(entrenador.esEliteGalactico())
    }

    test "Arquitecto de energía con 11 ciclos pero sin sintonía → no es de élite." {
        const entrenador = new Entrenadores(
            cantDeCiclosSolaresDeExp = 11,
            estaEnSintonia = false,
            nivelDePrecisionEstrategica = 90,
            rol = "Arquitecto de Energía"
        )

        assert.notThat(entrenador.esEliteGalactico())
    }

    test "Guía mental con 15 ciclos → siempre es de élite." {
        const entrenador = new Entrenadores(
            cantDeCiclosSolaresDeExp = 15,
            estaEnSintonia = false,
            nivelDePrecisionEstrategica = 0,
            rol = "Guía Mental"
        )

        assert.that(entrenador.esEliteGalactico())
    }
}

describe "Checkpoint 3 - Equipos de prestigio universal." {
    test "Equipo lumínico con 3 cristales, entrenador de élite y una tecnología activa → es de prestigio universal." {
        const pepe = new Entrenadores(
            cantDeCiclosSolaresDeExp = 12,
            estaEnSintonia = false,
            nivelDePrecisionEstrategica = 90,
            rol = "Estratega Cuántico"
        )

        const nucleosGravitacionales = new Tecnologias(
            nombre = "nucleos gravitacionales",
            valorEnergetico = 200,
            activa = true
        )

        const grupo = new Luminicos(
            nombre = "Galaxy",
            energiaBase = 100,
            entrenador = pepe,
            tecnologias = [nucleosGravitacionales],
            nivelDeRadiacion = 1000,
            nombresDeCristalesSolares = ["Cristal 1", "Cristal 2", "Cristal 3"]
        )


        assert.equals(3, grupo.cantDeCristalesSolares())
        assert.that(pepe.esEliteGalactico())
        assert.that(grupo.esDePrestigioUniversal())
    }

    test "Equipo sintético certificado con 4 módulos y todas las tecnologías activas → es de prestigio." {
        const felipe = new Entrenadores(
            cantDeCiclosSolaresDeExp = 30,
            estaEnSintonia = false,
            nivelDePrecisionEstrategica = 90,
            rol = "Estratega Cuántico"
        )

        const nucleosGravitacionales = new Tecnologias(
            nombre = "nucleos gravitacionales",
            valorEnergetico = 200,
            activa = true
        )

        const grupo = new Sinteticos(
            nombre = "Galaxy",
            energiaBase = 100,
            entrenador = felipe,
            tecnologias = [nucleosGravitacionales],
            nivelDeProcesamientoCentral = 40,
            cantDeModulosActivos = 4,
            estaCertificado = true
        )


        assert.equals(4, grupo.cantDeModulosActivos())
        assert.that(grupo.estaCertificado())
        assert.that(grupo.esDePrestigioUniversal())
    }

    test "Equipo lumínico con menos de 3 cristales no es de prestigio universal." {
        const entrenador = new Entrenadores(
            cantDeCiclosSolaresDeExp = 12,
            estaEnSintonia = false,
            nivelDePrecisionEstrategica = 90,
            rol = "Estratega Cuántico"
        )
        const tecnologia = new Tecnologias(
            nombre = "nucleo gravitacional",
            valorEnergetico = 200,
            activa = true
        )
        const equipo = new Luminicos(
            nombre = "Aurora",
            energiaBase = 100,
            entrenador = entrenador,
            tecnologias = [tecnologia],
            nivelDeRadiacion = 1000,
            nombresDeCristalesSolares = ["Cristal 1", "Cristal 2"]
        )

        assert.notThat(equipo.esDePrestigioUniversal())
    }

    test "Equipo sintético con una tecnología inactiva no es de prestigio universal." {
        const tecnologiaActiva = new Tecnologias(
            nombre = "nucleo gravitacional",
            valorEnergetico = 200,
            activa = true
        )
        const tecnologiaInactiva = new Tecnologias(
            nombre = "interfaz mental",
            valorEnergetico = 100,
            activa = false
        )
        const equipo = new Sinteticos(
            nombre = "Nexo",
            energiaBase = 100,
            entrenador = null,
            tecnologias = [tecnologiaActiva, tecnologiaInactiva],
            nivelDeProcesamientoCentral = 40,
            cantDeModulosActivos = 4,
            estaCertificado = true
        )

        assert.notThat(equipo.esDePrestigioUniversal())
    }
}

describe "Checkpoint 4 - Equipos etéricos." {
    test "Equipo etérico con 3 portales, fluctuación 80 y 2 tecnologías activas → es de prestigio universal." {
        const tecnologiaUno = new Tecnologias(
            nombre = "nucleo gravitacional",
            valorEnergetico = 100,
            activa = true
        )
        const tecnologiaDos = new Tecnologias(
            nombre = "interfaz mental",
            valorEnergetico = 200,
            activa = true
        )
        const equipo = new EquipoEterico(
            nombre = "Umbral",
            energiaBase = 100,
            entrenador = null,
            tecnologias = [tecnologiaUno, tecnologiaDos],
            nivelDeFluctuacionDimensional = 80,
            cantDePortalesAbiertos = 3
        )

        assert.that(equipo.esDePrestigioUniversal())
    }

    test "Verificar que el incremento del 15% se aplica correctamente." {
        const tecnologiaUno = new Tecnologias(
            nombre = "nucleo gravitacional",
            valorEnergetico = 100,
            activa = true
        )
        const tecnologiaDos = new Tecnologias(
            nombre = "interfaz mental",
            valorEnergetico = 200,
            activa = true
        )
        const equipo = new EquipoEterico(
            nombre = "Umbral",
            energiaBase = 100,
            entrenador = null,
            tecnologias = [tecnologiaUno, tecnologiaDos],
            nivelDeFluctuacionDimensional = 80,
            cantDePortalesAbiertos = 3
        )

        assert.equals(460, equipo.energiaTotal())
    }

    test "Verificar que un equipo etérico que no cumple las condiciones no suma el 15%." {
        const tecnologiaUno = new Tecnologias(
            nombre = "nucleo gravitacional",
            valorEnergetico = 100,
            activa = true
        )
        const tecnologiaDos = new Tecnologias(
            nombre = "interfaz mental",
            valorEnergetico = 200,
            activa = true
        )
        const equipo = new EquipoEterico(
            nombre = "Umbral",
            energiaBase = 100,
            entrenador = null,
            tecnologias = [tecnologiaUno, tecnologiaDos],
            nivelDeFluctuacionDimensional = 75,
            cantDePortalesAbiertos = 3
        )

        assert.notThat(equipo.esDePrestigioUniversal())
        assert.equals(400, equipo.energiaTotal())
    }
}